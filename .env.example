# Base URL from which anatomy assets (index.json, bundles, ontology, education) are served.
# Defaults to /anatomy which is served from apps/web/public/anatomy (the committed dev fixture).
# Point this at a CDN or local asset mirror to use real production bundles without code changes.
VITE_ANATOMY_ASSET_BASE_URL=/anatomy

# Release/license policy the client enforces when loading geometry:
#   internal_development | external_preview | commercial_release
VITE_ANATOMY_RELEASE_POLICY=internal_development

# Set to 1 to verify bundle GLB SHA-256 hashes in the browser before use (dev/QA workflow;
# adds hashing cost on load, off by default).
VITE_ANATOMY_VERIFY_HASHES=0
