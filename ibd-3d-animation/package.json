{
  "name": "dftg-ibd-3d-animation",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive 3D explainer of inflammatory bowel disease (Crohn's disease and ulcerative colitis) for the Don't Fret The Gut website.",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "npm run build && playwright test",
    "build:single": "vite build --config vite.preview.config.ts && node scripts/make-preview.mjs",
    "screenshots": "npm run build:single && node scripts/screenshots.mjs",
    "video": "npm run build:single && node scripts/render-video.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.4",
    "@react-three/fiber": "9.3.0",
    "@react-three/postprocessing": "3.0.4",
    "gsap": "3.13.0",
    "motion": "12.23.12",
    "postprocessing": "6.39.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "5.0.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
