{
  "name": "dftg-site",
  "version": "0.1.0",
  "private": true,
  "description": "Don't Fret the Gut website with the Inside the Gut 3D IBD explainer.",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "npm run build && playwright test",
    "build:embed": "PREVIEW_ENTRY=embed vite build --config vite.preview.config.ts && node scripts/make-preview.mjs embed",
    "build:preview": "VITE_ROUTER=hash PREVIEW_ENTRY=site vite build --config vite.preview.config.ts && node scripts/make-preview.mjs site",
    "build:pages": "VITE_BASE=/DFTG/ vite build && cp dist/index.html dist/404.html",
    "screenshots": "npm run build:embed && node scripts/screenshots.mjs",
    "screenshots:site": "npm run build && node scripts/site-screenshots.mjs",
    "video": "npm run build:embed && node scripts/render-video.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.4",
    "@react-three/fiber": "9.3.0",
    "@react-three/postprocessing": "3.0.4",
    "gsap": "3.13.0",
    "lucide-react": "0.542.0",
    "motion": "12.23.12",
    "postprocessing": "6.39.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "6.30.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "5.0.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
